# ─── SEO + Deployment (M11 — Vercel) ─────────────────────────────
NEXT_PUBLIC_SITE_URL=       # Domínio público, ex: https://nexuslabs.ai ou https://nexuslabsai.vercel.app

# ─── PipeFlow CRM (ingestão de leads — obrigatório) ──────────────
PIPEFLOW_API_URL=           # URL base do PipeFlow, ex: https://crm.pipeflow.io
PIPEFLOW_INGEST_TOKEN=      # Bearer token — PipeFlow > Configurações > API Tokens

# ─── IA (Chat Widget M9) ─────────────────────────────────────────
ANTHROPIC_API_KEY=          # Claude API key para diagnóstico conversacional
OPENAI_API_KEY=             # OpenAI (opcional, fallback)
